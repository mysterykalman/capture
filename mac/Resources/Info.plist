	<!--
	 Screen Recording, Accessibility, Microphone, and Camera are NOT declared
	 as always-required here (no NSCameraUsageDescription forcing a launch
	 prompt) — per docs/PERMISSIONS.md, each is requested progressively, only
	 when the specific feature that needs it is invoked. Usage-description
	 strings are still required by the OS the first time each is actually
	 requested, so they are present, but nothing here forces an eager prompt.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Capture uses the microphone only when you start a recording that includes microphone audio.</string>
	<key>NSCameraUsageDescription</key>
	<string>Capture uses the camera only when you start a recording with a camera overlay.</string>
</dict>
